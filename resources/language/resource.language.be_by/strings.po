msgctxt "#33120"
msgid "Select the libraries to add"
msgstr "Абярыце бібліятэкі для дадання"

msgctxt "#33121"
msgid "All"
msgstr "Усе"

msgctxt "#33122"
msgid "Restart Kodi to resume where you left off."
