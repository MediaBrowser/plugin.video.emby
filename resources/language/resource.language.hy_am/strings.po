msgstr "Փոխարինե՞լ գոյություն ունեցող կրկնօրինակը:"

msgctxt "#33091"
msgid "Created backup at:"
msgstr "Ստեղծվել է կրկնօրինակ՝"

msgctxt "#33092"
msgid "Create a backup"
msgstr "Ստեղծեք կրկնօրինակ"

msgctxt "#33093"
msgid "Backup folder"
msgstr "Պահուստային թղթապանակ"

msgctxt "#33097"
msgid "Important, cleanonupdate was removed in your advanced settings to prevent conflict with Emby for Kodi. Kodi will restart now."
msgstr "Կարևոր է, մաքրման թարմացումը հեռացվել է ձեր առաջադեմ կարգավորումներից՝ Emby-ի հետ հակամարտությունը Կոդիի համար կանխելու համար: "

msgctxt "#33098"
msgid "Refresh boxsets"
msgstr "Թարմացրեք տուփերը"

msgctxt "#33099"
msgid "Install the server plugin Kodi Companion to automatically apply emby library updates at startup. This setting can be found in the add-on settings > sync options > Enable Kodi Companion."
msgstr "Տեղադրեք Kodi Companion սերվերի հավելվածը՝ գործարկման ժամանակ ավտոմատ կերպով կիրառելու emby գրադարանի թարմացումները: "

msgctxt "#33100"
msgid "Would you like to sync empty shows?"
msgstr "Կցանկանա՞ք համաժամացնել դատարկ հաղորդումները:"

msgctxt "#33101"
msgid "Since you are using native playback mode with music enabled, do you want to import music rating from files?"
msgstr "Քանի որ դուք օգտագործում եք նվագարկման բնօրինակ ռեժիմը միացված երաժշտությամբ, ուզու՞մ եք ներմուծել երաժշտության վարկանիշը ֆայլերից:"

msgctxt "#33102"
msgid "Resume the previous sync?"
msgstr "Վերսկսե՞լ նախորդ համաժամացումը:"

msgctxt "#33103"
msgid "Enable the webserver service in the Kodi settings to allow artwork caching."
msgstr "Միացրեք վեբսերվերի ծառայությունը Kodi-ի կարգավորումներում՝ թույլ տալու արվեստի գործերի քեշավորումը:"

msgctxt "#33104"
msgid "Find more info in the github wiki/Create-and-restore-from-backup."
msgstr "Գտեք ավելի շատ տեղեկություններ github wiki/Create-and-restore-from-backup-ում:"

msgctxt "#33105"
msgid "Enable the context menu"
msgstr "Միացնել համատեքստի ընտրացանկը"

msgctxt "#33106"
msgid "Enable the option to transcode"
msgstr "Միացնել տրանսկոդավորման տարբերակը"

msgctxt "#33107"
msgid "Users added to the session"
msgstr "Նիստին ավելացվել են օգտատերեր"

msgctxt "#33108"
msgid "Notifications are delayed during video playback (except live tv)."
msgstr "Ծանուցումները հետաձգվում են տեսահոլովակի նվագարկման ժամանակ (բացառությամբ ուղիղ հեռարձակման):"

msgctxt "#33109"
msgid "Plugin"
msgstr "Փլագին"

msgctxt "#33110"
msgid "Restart Kodi to take effect."
msgstr "Վերագործարկեք Kodi-ն ուժի մեջ մտնելու համար:"

msgctxt "#33111"
msgid "Reset the local database to apply the playback mode change."
msgstr "Վերականգնել տեղական տվյալների բազան՝ նվագարկման ռեժիմի փոփոխությունը կիրառելու համար:"

msgctxt "#33112"
msgid "Applies to Native and Add-on playback mode"
msgstr "Կիրառվում է բնիկ և հավելյալ նվագարկման ռեժիմին"

msgctxt "#33113"
msgid "Applies to Add-on playback mode only"
msgstr "Կիրառվում է միայն հավելյալ նվագարկման ռեժիմին"

msgctxt "#33114"
msgid "Enable external subtitles"
msgstr "Միացնել արտաքին ենթագրերը"

msgctxt "#33115"
msgid "Adjust for remote connection"
msgstr "Կարգավորեք հեռակա կապի համար"

msgctxt "#33116"
msgid "Compress artwork (reduces quality)"
msgstr "Սեղմել արվեստի գործերը (նվազեցնում է որակը)"

msgctxt "#33117"
msgid "Enable artwork caching? If not, Kodi will still cache your artwork at a slower pace."
msgstr "Միացնե՞լ արվեստի գործերի քեշավորումը: "

msgctxt "#33118"
msgid "You've change the playback mode. Kodi needs to be reset to apply the change, would you like to do this now?"
msgstr "Դուք փոխել եք նվագարկման ռեժիմը: "

msgctxt "#33119"
msgid "Something went wrong during the sync. You'll be able to restore progress when restarting Kodi. If the problem persists, please report on the Emby for Kodi forums, with your Kodi log."
msgstr "Համաժամացման ընթացքում ինչ-որ սխալ տեղի ունեցավ: "

msgctxt "#33120"
msgid "Select the libraries to add"
msgstr "Ընտրեք գրադարանները՝ ավելացնելու համար"

msgctxt "#33121"
msgid "All"
msgstr "Բոլորը"

msgctxt "#33122"
msgid "Restart Kodi to resume where you left off."
msgstr "Վերագործարկեք Kodi-ն՝ վերսկսելու այնտեղ, որտեղ թողել եք:"

msgctxt "#33123"
msgid "Sync library to Kodi"
msgstr "Համաժամացրեք գրադարանը Kodi-ի հետ"

msgctxt "#33124"
msgid "Include people (slow)"
msgstr "Ներառեք մարդկանց (դանդաղ)"

msgctxt "#33125"
msgid "Choose the Emby views to sync to Kodi. You can optionally sync libraries at a later time."
msgstr "Ընտրեք Emby դիտումները՝ Կոդիի հետ համաժամացնելու համար: "

msgctxt "#33126"
msgid "Sync later"
msgstr "Համաժամեցեք ավելի ուշ"

msgctxt "#33127"
msgid "Proceed"
msgstr "Շարունակել"

msgctxt "#33128"
msgid "Failed to retrieve latest content updates. No content updates will be applied until Kodi is restarted. If this issue persists, please report on the Emby for Kodi forums, with your Kodi log."
msgstr "Չհաջողվեց առբերել բովանդակության վերջին թարմացումները: "

msgctxt "#33129"
msgid "You can sync libraries by launching the Emby add-on > Add libraries."
msgstr "Դուք կարող եք համաժամացնել գրադարանները՝ գործարկելով Emby հավելումը > Ավելացնել գրադարաններ:"

msgctxt "#33130"
msgid "Select the source"
msgstr "Ընտրեք աղբյուրը"

msgctxt "#33131"
msgid "Refreshing boxsets"
msgstr "Թարմացնող տուփեր"

msgctxt "#33132"
msgid "Repair library"
msgstr "Վերանորոգում գրադարան"

msgctxt "#33133"
msgid "Remove library from Kodi"
msgstr "Հեռացրեք գրադարանը Kodi-ից"

msgctxt "#33134"
msgid "Add server"
msgstr "Ավելացնել սերվեր"

msgctxt "#33135"
msgid "Kodi will now restart to apply a small patch for your Kodi version."
msgstr "Kodi-ն այժմ կվերագործարկվի՝ ձեր Kodi տարբերակի համար փոքրիկ կարկատել կիրառելու համար:"

msgctxt "#33136"
msgid "Update library"
msgstr "Թարմացրեք գրադարանը"

msgctxt "#33137"
msgid "Enable Kodi Companion (server plugin)"
msgstr "Միացնել Kodi Companion-ը (սերվերի հավելված)"

msgctxt "#33138"
msgid "You can update your library manually rather than rely on the server plugin Kodi companion. Launch the add-on and update libraries (or per library). To remove content, you'll need to repair the library."
msgstr "Դուք կարող եք ձեռքով թարմացնել ձեր գրադարանը, այլ ոչ թե ապավինել սերվերի plugin Kodi ուղեկիցին: "

msgctxt "#33139"
msgid "Update libraries"
msgstr "Թարմացրեք գրադարանները"

msgctxt "#33140"
msgid "Repair libraries"
msgstr "Վերանորոգեք գրադարանները"

msgctxt "#33141"
msgid "Remove server"
msgstr "Հեռացնել սերվերը"

msgctxt "#33142"
msgid "Something went wrong. Try again later."
msgstr "Ինչ-որ բան սխալ է տեղի ունեցել: "

msgctxt "#33144"
msgid "Removing library"
msgstr "Գրադարանի հեռացում"

msgctxt "#33145"
msgid "Please make sure your Emby server libraries are accessible to your Kodi installation and that you have path substitution configured on your server. For more information, check the FAQ in Emby for Kodi's github wiki."
msgstr "Խնդրում ենք համոզվել, որ ձեր Emby սերվերի գրադարանները հասանելի են ձեր Kodi-ի տեղադրմանը, և որ ձեր սերվերի վրա կազմաձևված է ուղու փոխարինում: "

msgctxt "#33146"
msgid "Unable to connect to Emby."
msgstr "Հնարավոր չէ միանալ Emby-ին:"

msgctxt "#33147"
msgid "Your access to Emby is restricted."
msgstr "Ձեր մուտքը Emby սահմանափակված է:"

msgctxt "#33148"
msgid "Your access to this server is restricted."
msgstr "Ձեր մուտքն այս սերվեր սահմանափակված է:"

msgctxt "#33149"
msgid "Unable to connect to this server."
msgstr "Հնարավոր չէ միանալ այս սերվերին:"

msgctxt "#33150"
msgid "Update server information"
msgstr "Թարմացրեք սերվերի տեղեկատվությունը"

msgctxt "#33151"
msgid "Reconnect to the same server that was previously loaded. If you want to use a different server, reset your local database, including your user information."
msgstr "Վերամիացեք նույն սերվերին, որը նախկինում բեռնված էր: "

msgctxt "#33152"
msgid "Unable to locate TV Tunes in Kodi."
msgstr "Հնարավոր չէ գտնել հեռուստատեսային մեղեդիները Կոդիում:"

msgctxt "#33153"
msgid "Your Emby theme media has been synced to Kodi"
msgstr "Ձեր Emby թեմայի մեդիան համաժամեցվել է Kodi-ի հետ"

msgctxt "#33154"
msgid "Add libraries"
msgstr "Ավելացնել գրադարաններ"

msgctxt "#33155"
msgid "The currently applied patch for Emby for Kodi is corrupted! Please post to the Emby for Kodi forums if this issue persists. This will need to be fixed as soon as possible."
msgstr "Կոդիի համար Emby-ի համար ներկայումս կիրառվող կարկատելը կոռումպացված է: "

msgctxt "#33156"
msgid "A patch has been applied!"
msgstr "Կիրառվել է կարկատ:"

msgctxt "#33157"
msgid "Audio only"
msgstr "Միայն աուդիո"

msgctxt "#33158"
msgid "Subtitles only"
msgstr "Միայն ենթագրեր"

msgctxt "#33159"
msgid "Enable audio/subtitles selection"
msgstr "Միացնել աուդիո/ենթագրերի ընտրությունը"

msgctxt "#33160"
msgid "To avoid errors, please update Emby for Kodi to version: "
msgstr "Սխալներից խուսափելու համար խնդրում ենք թարմացնել Emby-ը Kodi-ի համար տարբերակի. "

msgctxt "#33161"
msgid "Check for updates"
msgstr "Ստուգեք թարմացումների համար"

msgctxt "#33162"
msgid "Reset the music library?"
msgstr "Վերականգնե՞լ երաժշտական գրադարանը:"

msgctxt "#33163"
msgid "Support this project"
msgstr "Աջակցեք այս նախագծին"

msgctxt "#33164"
msgid "Mask sensitive information in log (does not apply to kodi logging)"
msgstr "Քողարկեք զգայուն տեղեկատվությունը գրանցամատյանում (չի տարածվում kodi logging-ի վրա)"

msgctxt "#33165"
msgid "Failed to create backup"
msgstr "Չհաջողվեց ստեղծել կրկնօրինակ"

msgctxt "#33166"
msgid "(dynamic)"
msgstr "(դինամիկ)"

msgctxt "#33167"
msgid "Recently added"
msgstr "Վերջերս ավելացված"

msgctxt "#33168"
msgid "Favourites"
msgstr "Ֆավորիտներ"

msgctxt "#33169"
msgid "In Progress"
msgstr "Ընթացքի մեջ"

msgctxt "#33170"
msgid "Unwatched"
msgstr "Չդիտված"

msgctxt "#33171"
msgid "By first letter"
msgstr "Առաջին տառով"

msgctxt "#33172"
msgid "You have {number} updates pending. This may take a little while before seeing new content. It might be faster to update your libraries via launching the Emby add-on > update libraries. Proceed anyway?"
msgstr "Դուք ունեք {number} թարմացումներ: "

msgctxt "#33173"
msgid "Forget about the previous sync? This is not recommended."
msgstr "Մոռացե՞լ եք նախորդ համաժամացման մասին: "

msgctxt "#33174"
msgid "Paging - download threads (default: 3)"
msgstr "Paging - ներբեռնման շղթաներ (կանխադրված՝ 3)"

msgctxt "#33175"
msgid "Paging tip: Each download thread requests your max items value from Emby at the same time."
msgstr "Էջավորման հուշում. ներբեռնման յուրաքանչյուր շարանը Emby-ից պահանջում է ձեր ապրանքների առավելագույն արժեքը միաժամանակ:"

msgctxt "#33176"
msgid "Update or repair your libraries to apply the changes below."
msgstr "Թարմացրեք կամ վերանորոգեք ձեր գրադարանները՝ ստորև ներկայացված փոփոխությունները կիրառելու համար:"

msgctxt "#33177"
msgid "Display the progress bar if update count greater than"
msgstr "Ցուցադրել առաջընթացի սանդղակը, եթե թարմացումների քանակը գերազանցում է"

msgctxt "#33178"
msgid "Processing updates"
msgstr "Թարմացումների մշակում"

msgctxt "#33179"
msgid "Force transcode"
msgstr "Ուժի տրանսկոդ"

msgctxt "#33180"
msgid "Restart Emby for Kodi"
msgstr "Վերագործարկեք Emby-ը Kodi-ի համար"

msgctxt "#33181"
msgid "Restarting to apply the patch"
msgstr "Վերսկսվում է կարկատելը կիրառելու համար"

msgctxt "#33182"
msgid "Play with cinema mode"
msgstr "Խաղացեք կինոյի ռեժիմով"

msgctxt "#33183"
msgid "Enable the option to play with cinema mode"
msgstr "Միացրեք կինոյի ռեժիմով խաղալու տարբերակը"

msgctxt "#33184"
msgid "Remove libraries"
msgstr "Հեռացրեք գրադարանները"

msgctxt "#33185"
msgid "Enable sync during playback (may cause some lag)"
msgstr "Միացնել համաժամացումը նվագարկման ընթացքում (կարող է որոշակի ուշացում առաջացնել)"

msgctxt "#33186"
msgid "The Kodi companion speeds up the start up sync. Other syncs are triggered by server events."
msgstr "Kodi-ի ուղեկիցը արագացնում է գործարկման համաժամացումը: "

msgctxt "#33187"
msgid "Sync Rotten Tomatoes ratings"
msgstr "Sync Rotten Tomatoes-ի վարկանիշները"

msgctxt "#33188"
msgid "Would you like to sync Rotten Tomatoes ratings?"
msgstr "Ցանկանու՞մ եք համաժամեցնել Rotten Tomatoes-ի վարկանիշները:"

msgctxt "#33191"
msgid "Restart Emby for Kodi to apply this change?"
msgstr "Վերագործարկեք Emby-ն, որպեսզի Kodi-ն կիրառի այս փոփոխությունը:"

msgctxt "#33192"
msgid "Restart Emby for Kodi"
msgstr "Վերագործարկեք Emby-ը Kodi-ի համար"

msgctxt "#33193"
msgid "Restarting..."
msgstr "Վերագործարկում..."

msgctxt "#33194"
msgid "Manage libraries"
msgstr "Կառավարեք գրադարանները"

msgctxt "#33195"
msgid "Enable Emby for Kodi"
msgstr "Միացնել Emby-ը Kodi-ի համար"

msgctxt "#33196"
msgid "Advanced options"
