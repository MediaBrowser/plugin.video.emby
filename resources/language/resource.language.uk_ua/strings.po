msgctxt "#33108"
msgid "Notifications are delayed during video playback (except live tv)."
msgstr "Повідомлення затримуються під час відтворення відео (окрім прямого телебачення)."

msgctxt "#33109"
msgid "Plugin"
msgstr "Плагін"

msgctxt "#33110"
msgid "Restart Kodi to take effect."
msgstr "Перезапустіть Kodi, щоб набуло чинності."

msgctxt "#33111"
msgid "Reset the local database to apply the playback mode change."
msgstr "Скинути локальну базу даних, щоб застосувати зміну режиму відтворення."

msgctxt "#33112"
msgid "Applies to Native and Add-on playback mode"
msgstr "Застосовується до рідного та додаткового режимів відтворення"

msgctxt "#33113"
msgid "Applies to Add-on playback mode only"
msgstr "Застосовується лише до додаткового режиму відтворення"

msgctxt "#33114"
msgid "Enable external subtitles"
msgstr "Увімкнути зовнішні субтитри"

msgctxt "#33115"
