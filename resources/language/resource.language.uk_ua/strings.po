msgid "Select the libraries to add"
msgstr "Виберіть бібліотеки для додавання"

msgctxt "#33121"
msgid "All"
msgstr "Все"

msgctxt "#33122"
msgid "Restart Kodi to resume where you left off."
msgstr "Перезапустіть Kodi, щоб продовжити з того місця, де ви зупинилися."

msgctxt "#33123"
