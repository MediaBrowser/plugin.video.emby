msgstr "Omogočite storitev spletnega strežnika v nastavitvah Kodi, da omogočite predpomnjenje umetnin."

msgctxt "#33104"
msgid "Find more info in the github wiki/Create-and-restore-from-backup."
msgstr "Poiščite več informacij v github wiki/Create-and-restore-from-backup."

