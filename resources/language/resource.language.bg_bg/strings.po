msgid "Database reset has completed, Kodi will now restart to apply the changes."
msgstr "Нулирането на базата данни завърши, Kodi ще се рестартира, за да приложи промените."

msgctxt "#33089"
msgid "Enter folder name for backup"
msgstr "Въведете име на папка за архивиране"

msgctxt "#33090"
msgid "Replace existing backup?"
