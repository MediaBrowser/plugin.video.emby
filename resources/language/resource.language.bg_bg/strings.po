msgctxt "#33109"
msgid "Plugin"
msgstr "Плъгин"

msgctxt "#33110"
msgid "Restart Kodi to take effect."
msgstr "Рестартирайте Kodi, за да влезе в сила."

msgctxt "#33111"
msgid "Reset the local database to apply the playback mode change."
msgstr "Нулирайте локалната база данни, за да приложите промяната в режима на възпроизвеждане."

msgctxt "#33112"
msgid "Applies to Native and Add-on playback mode"
msgstr "Прилага се за собствен режим и режим на възпроизвеждане с добавки"

msgctxt "#33113"
msgid "Applies to Add-on playback mode only"
msgstr "Прилага се само за режим на възпроизвеждане с добавки"

msgctxt "#33114"
msgid "Enable external subtitles"
msgstr "Активиране на външни субтитри"

msgctxt "#33115"
msgid "Adjust for remote connection"
msgstr "Настройка за отдалечена връзка"

msgctxt "#33116"
msgid "Compress artwork (reduces quality)"
