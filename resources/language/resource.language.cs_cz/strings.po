msgctxt "#33037"
msgid "Native (direct paths)"
msgstr "Nativní (přímé cesty)"

msgctxt "#33039"
msgid "Enable music library?"
msgstr "Povolit hudební knihovnu?"

msgctxt "#33042"
msgid "Running the caching process may take some time. Continue anyway?"
msgstr "Spuštění procesu ukládání do mezipaměti může nějakou dobu trvat. Opravdu pokračovat?"

