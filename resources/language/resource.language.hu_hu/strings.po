msgctxt "#33088"
msgid "Database reset has completed, Kodi will now restart to apply the changes."
msgstr "Az adatbázis-visszaállítás befejeződött, a Kodi most újraindul a módosítások alkalmazásához."

msgctxt "#33089"
msgid "Enter folder name for backup"
msgstr "Adja meg a mappa nevét a biztonsági mentéshez"

msgctxt "#33090"
msgid "Replace existing backup?"
