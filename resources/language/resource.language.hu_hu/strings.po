msgctxt "#33093"
msgid "Backup folder"
msgstr "Biztonsági mentés mappa"

msgctxt "#33097"
msgid "Important, cleanonupdate was removed in your advanced settings to prevent conflict with Emby for Kodi. Kodi will restart now."
msgstr "Fontos: a Cleanonupdate eltávolításra került a speciális beállítások közül, hogy elkerüljük az Emby for Kodi-val való ütközést. "

msgctxt "#33098"
msgid "Refresh boxsets"
msgstr "Boxkészletek frissítése"

msgctxt "#33099"
msgid "Install the server plugin Kodi Companion to automatically apply emby library updates at startup. This setting can be found in the add-on settings > sync options > Enable Kodi Companion."
msgstr "Telepítse a Kodi Companion kiszolgálóbővítményt, hogy az indításkor automatikusan alkalmazza az emby könyvtár frissítéseit. "

msgctxt "#33100"
msgid "Would you like to sync empty shows?"
msgstr "Szeretné szinkronizálni az üres műsorokat?"

msgctxt "#33101"
msgid "Since you are using native playback mode with music enabled, do you want to import music rating from files?"
msgstr "Mivel natív lejátszási módot használ zenével, szeretne zenei besorolást importálni a fájlokból?"

msgctxt "#33102"
msgid "Resume the previous sync?"
msgstr "Folytatja az előző szinkronizálást?"

msgctxt "#33103"
msgid "Enable the webserver service in the Kodi settings to allow artwork caching."
msgstr "Engedélyezze a webszerver szolgáltatást a Kodi beállításaiban, hogy engedélyezze a grafikák gyorsítótárazását."

msgctxt "#33104"
msgid "Find more info in the github wiki/Create-and-restore-from-backup."
msgstr "További információkat találhat a github wikiben/Create-and-restore-from-backup."

msgctxt "#33105"
