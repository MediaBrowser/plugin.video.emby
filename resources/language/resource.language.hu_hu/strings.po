msgctxt "#33107"
msgid "Users added to the session"
msgstr "Felhasználók hozzáadva a munkamenethez"

msgctxt "#33108"
msgid "Notifications are delayed during video playback (except live tv)."
msgstr "Az értesítések késleltetésre kerülnek a videó lejátszása közben (kivéve élő tévéadást)."

msgctxt "#33109"
msgid "Plugin"
msgstr ""

msgctxt "#33110"
msgid "Restart Kodi to take effect."
msgstr "Indítsa újra a Kodi alkalmazást, hogy életbe lépjen."

msgctxt "#33111"
msgid "Reset the local database to apply the playback mode change."
msgstr "Állítsa vissza a helyi adatbázist a lejátszási mód módosításához."

msgctxt "#33112"
msgid "Applies to Native and Add-on playback mode"
msgstr "Natív és kiegészítő lejátszási módra vonatkozik"

msgctxt "#33113"
msgid "Applies to Add-on playback mode only"
msgstr "Csak a kiegészítő lejátszási módra vonatkozik"

msgctxt "#33114"
msgid "Enable external subtitles"
msgstr "Külső feliratok engedélyezése"

msgctxt "#33115"
msgid "Adjust for remote connection"
msgstr "Távoli kapcsolat beállítása"

msgctxt "#33116"
msgid "Compress artwork (reduces quality)"
msgstr "A grafika tömörítése (csökkenti a minőséget)"

msgctxt "#33117"
msgid "Enable artwork caching? If not, Kodi will still cache your artwork at a slower pace."
msgstr "Engedélyezi az alkotások gyorsítótárazását? "

msgctxt "#33118"
msgid "You've change the playback mode. Kodi needs to be reset to apply the change, would you like to do this now?"
msgstr "Megváltoztatta a lejátszási módot. "

msgctxt "#33119"
msgid "Something went wrong during the sync. You'll be able to restore progress when restarting Kodi. If the problem persists, please report on the Emby for Kodi forums, with your Kodi log."
msgstr "Valami hiba történt a szinkronizálás során. "

msgctxt "#33120"
msgid "Select the libraries to add"
msgstr "Válassza ki a hozzáadni kívánt könyvtárakat"

msgctxt "#33121"
msgid "All"
msgstr "Mind"

msgctxt "#33122"
msgid "Restart Kodi to resume where you left off."
msgstr "Indítsa újra a Kodi-t, hogy ott folytassa, ahol abbahagyta."

msgctxt "#33123"
msgid "Sync library to Kodi"
